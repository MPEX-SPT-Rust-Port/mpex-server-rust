<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Build.props" />
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
  <!-- SPT_Data is staged transitively via the SPTarkov.Server reference, which imports
       Libraries/SPTarkov.Server.Assets/Assets.props. ImageRouterTests and DI.cs read it from the
       test output directory. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\SPTarkov.Server.Core\SPTarkov.Server.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\SPTarkov.DI\SPTarkov.DI.csproj" />
    <ProjectReference Include="..\..\Libraries\SPTarkov.Common\SPTarkov.Common.csproj" />
    <ProjectReference Include="..\..\SPTarkov.Server\SPTarkov.Server.csproj" />
    <ProjectReference Include="..\TestMod\TestMod.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestAssets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Needed by tests that build the real early logger factory, which reads this from the working directory -->
    <None Include="..\..\SPTarkov.Server\sptLogger.json" Link="sptLogger.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\Mock\MockSptLogger.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Facade emitted by BuildSpectreFacade in SPTarkov.Common; see the note in Build.props. -->
    <Reference Include="Spectre.Console.Ansi">
      <HintPath>$(SpectreFacadePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
