<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Build.props" />
  <Import Project="..\..\Libraries\SPTarkov.Server.Assets\Assets.props" />
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\SPTarkov.Server.Core\SPTarkov.Server.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\SPTarkov.Common\SPTarkov.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\SPTarkov.DI\SPTarkov.DI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Facade emitted by BuildSpectreFacade in SPTarkov.Common; see the note in Build.props. -->
    <Reference Include="Spectre.Console.Ansi">
      <HintPath>$(SpectreFacadePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
