<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\Build.props" />
  <PropertyGroup>
    <PackageId>SPTarkov.Common</PackageId>
    <Authors>Single Player Tarkov</Authors>
    <Description>Common shared library for the Single Player Tarkov projects.</Description>
    <Copyright>Copyright (c) Single Player Tarkov 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://sp-tarkov.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sp-tarkov/server-csharp</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- LibraryImport generates unsafe marshalling for the spt_native log sink imports. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <!-- Facade emitted by BuildSpectreFacade in SPTarkov.Common; see the note in Build.props. -->
    <Reference Include="Spectre.Console.Ansi">
      <HintPath>$(SpectreFacadePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Emits the Spectre.Console.Ansi facade; see the note in Build.props. -->
  <Target
    Name="BuildSpectreFacade"
    BeforeTargets="ResolveAssemblyReferences"
    Inputs="$(SpectreFacadeDir)/spectre-facade/src/main.rs;$(SpectreFacadeDir)/spectre-facade/src/colors.rs;$(SpectreFacadeDir)/spectre-facade/Cargo.toml;$(SpectreFacadeDir)/Cargo.lock"
    Outputs="$(SpectreFacadePath)"
  >
    <MakeDir Directories="$(SpectreFacadeDir)/target/spectre-facade" />
    <Exec
      Command="cargo run --locked -q -p spectre-facade -- &quot;$(SpectreFacadePath)&quot;"
      WorkingDirectory="$(SpectreFacadeDir)"
      ConsoleToMsBuild="true"
    />
  </Target>
</Project>
