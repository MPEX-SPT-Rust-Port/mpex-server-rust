<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Build.props" />
  <PropertyGroup>
    <PackageId>SPTarkov.Server.Core</PackageId>
    <Authors>Single Player Tarkov</Authors>
    <Description>Core library for the Single Player Tarkov server.</Description>
    <Copyright>Copyright (c) Single Player Tarkov 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://sp-tarkov.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sp-tarkov/server-csharp</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SPTarkov.Common\SPTarkov.Common.csproj" />
    <ProjectReference Include="..\SPTarkov.DI\SPTarkov.DI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Include="FastCloner" Version="3.5.5" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
    <!-- DatabaseImporter calls the internal SptNative.DbLoad. Both names: SPTarkov.Server renames
         its assembly to SPT.Server, and to SPT.Server.Linux for a linux-x64 publish. -->
    <InternalsVisibleTo Include="SPT.Server" />
    <InternalsVisibleTo Include="SPT.Server.Linux" />
  </ItemGroup>
  <ItemGroup>
    <!-- Facade emitted by BuildSpectreFacade in SPTarkov.Common; see the note in Build.props. -->
    <Reference Include="Spectre.Console.Ansi">
      <HintPath>$(SpectreFacadePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="AfterEverythingDone" AfterTargets="PostBuildEvent">
    <!-- Run WriteBarriers patch (Phase 2). Must precede the ExtensionData patch: it walks property
         setters, and ExtensionData's is injected, not authored. Same Release/publish gate as its
         sibling - a Debug build has no barriers, which ResidentDbDispatch.Eligible accounts for. -->
    <Exec
      ConsoleToMsBuild="true"
      Condition="'$(IsPublish)' == 'true' or '$(Configuration)' == 'Release'"
      Command="dotnet build -c &quot;$(Configuration)&quot; &quot;$(MSBuildProjectDirectory)/../../Patches/Ceciler.WriteBarriers/Ceciler.WriteBarriers.csproj&quot;"
    />
    <Exec
      Condition="'$(IsPublish)' == 'true' or '$(Configuration)' == 'Release'"
      ConsoleToMsBuild="true"
      Command="dotnet &quot;$(MSBuildProjectDirectory)/../../Ceciler/Ceciler.Launcher.dll&quot; &quot;$(OutDir)SPTarkov.Server.Core.dll&quot; &quot;$(MSBuildProjectDirectory)/../../Patches/Ceciler.WriteBarriers/bin/$(Configuration)/$(TargetFramework)/Ceciler.WriteBarriers.dll&quot;"
    />
    <!-- Run ExtensionData patch -->
    <Exec
      ConsoleToMsBuild="true"
      Condition="'$(IsPublish)' == 'true' or '$(Configuration)' == 'Release'"
      Command="dotnet build -c &quot;$(Configuration)&quot; &quot;$(MSBuildProjectDirectory)/../../Patches/Ceciler.JsonExtensionData/Ceciler.JsonExtensionData.csproj&quot;"
    />
    <Exec
      Condition="'$(IsPublish)' == 'true' or '$(Configuration)' == 'Release'"
      ConsoleToMsBuild="true"
      Command="dotnet &quot;$(MSBuildProjectDirectory)/../../Ceciler/Ceciler.Launcher.dll&quot; &quot;$(OutDir)SPTarkov.Server.Core.dll&quot; &quot;$(MSBuildProjectDirectory)/../../Patches/Ceciler.JsonExtensionData/bin/$(Configuration)/$(TargetFramework)/Ceciler.JsonExtensionData.dll&quot;"
    />
  </Target>
  <!--  Generates the ProgramStatics class with the build information -->
  <Target Name="GenerateProgramStatics" BeforeTargets="CollectPackageReferences;CoreCompile">
    <WriteLinesToFile
      File="Utils/ProgramStatics.Generated.cs"
      Lines="// &lt;auto-generated /&gt;&#xD;&#xA;// This file is automatically generated. Do not modify manually.&#xD;&#xA;// Any changes made to this file will be overwritten during the build process.&#xD;&#xA;&#xD;&#xA;using SPTarkov.Server.Core.Models.Enums%3B&#xD;&#xA;&#xD;&#xA;using Version = SemanticVersioning.Version%3B&#xD;&#xA;&#xD;&#xA;namespace SPTarkov.Server.Core.Utils%3B&#xD;&#xA;&#xD;&#xA;public static partial class ProgramStatics&#xD;&#xA;{&#xD;&#xA;    private static Version SptVersion { get%3B } = new(&quot;$(SptVersion)&quot;)%3B&#xD;&#xA;    private static string Commit { get%3B } = &quot;$(SptCommit)&quot;%3B&#xD;&#xA;    private static double BuildTime { get%3B } = $(SptBuildTime)%3B&#xD;&#xA;    private static EntryType BuildType { get%3B } = EntryType.$(SptBuildType)%3B&#xD;&#xA;}&#xD;&#xA;"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
  </Target>
  <PropertyGroup>
    <SptNativeDir>$(MSBuildProjectDirectory)/../../rust</SptNativeDir>
    <SptNativeLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">spt_native.dll</SptNativeLibName>
    <SptNativeLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libspt_native.dylib</SptNativeLibName>
    <SptNativeLibName Condition="'$(SptNativeLibName)' == ''">libspt_native.so</SptNativeLibName>
    <!-- $(SptNativeTargetTriple) is set (Build.props) only for a cross-RID build; cargo then writes to target/<triple>/. -->
    <CargoTargetFlag Condition="'$(SptNativeTargetTriple)' != ''">--target $(SptNativeTargetTriple)</CargoTargetFlag>
    <SptNativeLibPath Condition="'$(SptNativeTargetTriple)' == ''"
      >$(SptNativeDir)/target/$(CargoProfile)/$(SptNativeLibName)</SptNativeLibPath>
    <SptNativeLibPath Condition="'$(SptNativeTargetTriple)' != ''"
      >$(SptNativeDir)/target/$(SptNativeTargetTriple)/$(CargoProfile)/$(SptNativeLibName)</SptNativeLibPath>
  </PropertyGroup>
  <ItemGroup>
    <SptNativeSource
      Include="$(SptNativeDir)/**/*.rs;$(SptNativeDir)/**/Cargo.toml;$(SptNativeDir)/Cargo.lock"
      Exclude="$(SptNativeDir)/target/**"
    />
  </ItemGroup>
  <Target Name="BuildSptNative" BeforeTargets="AssignTargetPaths" Inputs="@(SptNativeSource)" Outputs="$(SptNativeLibPath)">
    <!-- locked: fail fast on Cargo.lock drift instead of silently rewriting it (this fork has no CI to catch that). -->
    <Exec
      Command="cargo build --locked $(CargoProfileFlag) $(CargoTargetFlag)"
      WorkingDirectory="$(SptNativeDir)"
      ConsoleToMsBuild="true"
    />
    <ItemGroup>
      <!-- Always, not PreserveNewest: switching $(SptNativeRid) changes the source path, and a
           newer cross-built artifact already in the output dir would otherwise never be replaced. -->
      <None Include="$(SptNativeLibPath)">
        <Link>$(SptNativeLibName)</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>
</Project>
