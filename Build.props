<Project>
  <PropertyGroup>
    <!--  SPT specific  -->
    <SptVersion Condition="'$(SptVersion)' == ''">4.1.2</SptVersion>
    <SptCommit Condition="'$(SptCommit)' == ''">1F4810F</SptCommit>
    <SptBuildTime Condition="'$(SptBuildTime)' == ''">0000000000</SptBuildTime>
    <SptBuildType Condition="'$(SptBuildType)' == ''">LOCAL</SptBuildType>
    <!--  BuildType options - LOCAL, DEBUG, RELEASE - *must be all caps*-->
    <!-- SemVer-compliant version -->
    <!-- Format: 4.1.2-LOCAL+a12b34.0000000000 -->
    <Version>$(SptVersion)-$(SptBuildType)+$(SptCommit).$(SptBuildTime)</Version>
    <AssemblyVersion>$(SptVersion)</AssemblyVersion>
    <FileVersion>$(SptVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- The dotnet CLI sets _IsPublishing globally for `dotnet publish`; surface it as the
         IsPublish flag the Ceciler conditions in SPTarkov.Server.Core.csproj test. Without this
         the flag was never defined anywhere, so a non-Release publish (scripts/smoke-mpex-server.sh
         publishes Debug) silently skipped the IL rewrite CLAUDE.md documents as running on any
         publish - shipping a tree with no write barriers and no [JsonExtensionData]. -->
    <IsPublish Condition="'$(_IsPublishing)' == 'true'">true</IsPublish>
    <!-- Project settings -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RepositoryType>Git</RepositoryType>
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <!--
      rust/spt-native cross-compilation. `dotnet publish -r <rid>` does not flow RuntimeIdentifier to
      RID-agnostic project references, so a cross-RID build must name the target RID explicitly with
      -p:SptNativeRid=<rid>. Unset means "build for the build host's triple" - the normal path.
      Only same-OS targets are mapped; a foreign-OS triple needs that OS's linker/SDK. Building one
      also needs `rustup target add <triple>` and a matching cross linker on PATH (see Dockerfile).
      Consumed by BuildSptNative in SPTarkov.Server.Core.csproj and the guard in SPTarkov.Server.csproj.
    -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <SptNativeTargetTriple Condition="'$(SptNativeRid)' == 'linux-x64'">x86_64-unknown-linux-gnu</SptNativeTargetTriple>
  </PropertyGroup>
  <PropertyGroup>
    <CargoProfile Condition="'$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">debug</CargoProfile>
    <CargoProfileFlag Condition="'$(CargoProfile)' == 'release'">--release</CargoProfileFlag>
  </PropertyGroup>
  <!--
      Spectre.Console.Ansi is a facade emitted by rust/spectre-facade, not the real package. It exists
      only so compiled 4.1.2 mods can still bind Spectre.Console.Color, which is frozen into
      ISptLogger<T>, SptLogMessage, ClientLogRequest and Watermark.Draw. Colours are accepted and
      discarded - the logger emits plain text.

      Only the path lives here. The <Reference> itself sits in each of the five projects that name
      Color, because plain <Reference> items are not transitive and the other four have a
      ProjectReference chain to SPTarkov.Common, which emits the DLL - so the file always exists by
      the time they resolve. SPTarkov.Common itself needs no such chain: its own
      BeforeTargets="ResolveAssemblyReferences" BuildSpectreFacade target orders the emit ahead of
      its own reference resolution. Adding the path here instead would hand it to SPTarkov.DI and
      SPTarkov.Reflection, which have no such chain and would race the emit.
    -->
  <PropertyGroup>
    <SpectreFacadeDir>$(MSBuildThisFileDirectory)rust</SpectreFacadeDir>
    <SpectreFacadePath>$(SpectreFacadeDir)/target/spectre-facade/Spectre.Console.Ansi.dll</SpectreFacadePath>
  </PropertyGroup>
</Project>
