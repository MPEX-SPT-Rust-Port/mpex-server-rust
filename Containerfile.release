# Containerfile.release — end-user server image.
#
#   podman build -f Containerfile.release -t mpex-server --build-arg BACKEND_IP=<LAN-IP-or-hostname> .
#   podman run -d --name spt -p 6969:6969 -v spt-user:/app/user mpex-server
#
# BACKEND_IP is the address announced to game clients (default 127.0.0.1, i.e.
# client on the same machine as the container host). It is baked at BUILD time:
# RELEASE builds hash-verify SPT_Data against checks.dat at startup and refuse
# to run if configs were edited afterwards, so it cannot be changed at run time.
# Profiles and runtime state live in /app/user — keep it on a volume.
#
# The server is HTTPS-only on 6969, with a self-signed certificate generated into
# /app/user/certs on first start. Health check: curl -k https://<host>:6969/health
#
# The admin panel requires a login even from localhost. The seeded administrator
# credentials are spt/spt — change them on first use. Credentials live in
# /app/user/credentials/, i.e. on the volume and changeable at run time, unlike
# http.json.
FROM quay.io/fedora/fedora-minimal:44-x86_64 AS build

RUN dnf5 -y install dotnet-sdk-10.0 gcc mold git 7zip \
    && dnf5 clean all \
    && { command -v 7z >/dev/null 2>&1 || ln -s "$(command -v 7zz)" /usr/local/bin/7z; }

# rust/rust-toolchain.toml pins 1.97.1; dotnet publish shells out to cargo.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain 1.97.1 \
      --component rustfmt --component clippy --component llvm-tools
ENV PATH="/root/.cargo/bin:${PATH}"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

COPY . /src
WORKDIR /src
RUN scripts/decompress-assets.sh

# Bind on all interfaces inside the container; announce BACKEND_IP to clients.
# Patched BEFORE publish so the checks.dat regenerated by the Release build matches.
ARG BACKEND_IP=127.0.0.1
RUN sed -i \
      -e 's/"ip": "127.0.0.1"/"ip": "0.0.0.0"/' \
      -e "s/\"backendIp\": \"127.0.0.1\"/\"backendIp\": \"${BACKEND_IP}\"/" \
      -e 's/"requireCredentialsOnLocalhost": false/"requireCredentialsOnLocalhost": true/' \
      Libraries/SPTarkov.Server.Assets/SPT_Data/configs/http.json \
    && grep -q '"ip": "0.0.0.0"' Libraries/SPTarkov.Server.Assets/SPT_Data/configs/http.json \
    && grep -q '"requireCredentialsOnLocalhost": true' Libraries/SPTarkov.Server.Assets/SPT_Data/configs/http.json \
    && grep -q "\"backendIp\": \"${BACKEND_IP}\"" Libraries/SPTarkov.Server.Assets/SPT_Data/configs/http.json

# Publish the project, not the solution (.dockerignore excludes Testing/).
# -p:SptNativeRid is required for any RID-qualified publish (see Build.props).
RUN dotnet publish SPTarkov.Server/SPTarkov.Server.csproj \
      -c Release -r linux-x64 --self-contained \
      -p:SptNativeRid=linux-x64 -p:SptBuildType=RELEASE \
      -o /out

FROM quay.io/fedora/fedora-minimal:44-x86_64

# Self-contained .NET still needs ICU/krb5 from the OS; shadow-utils for useradd.
RUN dnf5 -y install libicu krb5-libs tzdata shadow-utils \
    && dnf5 clean all \
    && useradd --system --create-home --home-dir /app --shell /sbin/nologin spt

COPY --from=build --chown=spt:spt /out /app
USER spt
WORKDIR /app
EXPOSE 6969
VOLUME /app/user
ENTRYPOINT ["/app/SPT.Server.Linux"]
